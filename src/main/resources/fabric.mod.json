{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A light-weight proof of concept .kts script loader for Minecraft.",
  "authors": [
    "Starred"
  ],
  "contact": {},
  "license": "BSD 3-Clause",
  "icon": "assets/ktscript/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      {
        "value": "foo.starred.ktscript.KTScriptPreLaunchEntrypoint",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "foo.starred.ktscript.KTScript",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "ktscript.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-language-kotlin": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  },
  "accessWidener": "${accessWidener}"
}
